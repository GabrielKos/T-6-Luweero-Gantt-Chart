{
  "entities": {
    "tasks": {
      "title": "WBS Tasks",
      "description": "Tasks for KMC T-6 Battery Plant Master Workplan",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "wp": { "type": "string" },
        "activity": { "type": "string" },
        "lead": { "type": "string" },
        "support": { "type": "string" },
        "deadline": { "type": "string" },
        "startMs": { "type": "number" },
        "endMs": { "type": "number" },
        "status": { "type": "string" },
        "notes": { "type": "string" },
        "priority": { "type": "string" },
        "subtasks": { "type": "array" },
        "updatedBy": { "type": "string" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "wp", "activity", "lead", "deadline", "status"]
    },
    "activity_logs": {
      "title": "Activity Audit Logs",
      "description": "Track task updates across the team",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "taskId": { "type": "string" },
        "taskTitle": { "type": "string" },
        "action": { "type": "string" },
        "user": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["taskId", "action", "timestamp"]
    },
    "system_config": {
      "title": "System Configuration",
      "description": "System-wide brand logos and preferences",
      "type": "object",
      "properties": {
        "logoDataUrl": { "type": "string" },
        "updatedAt": { "type": "number" },
        "aspectRatio": { "type": "number" },
        "fileName": { "type": "string" }
      },
      "required": ["logoDataUrl", "updatedAt"]
    }
  },
  "firestore": {
    "/tasks_kmc_v1/{taskId}": {
      "schema": { "$ref": "#/entities/tasks" },
      "description": "WBS Tasks collection"
    },
    "/activity_logs_kmc_v1/{logId}": {
      "schema": { "$ref": "#/entities/activity_logs" },
      "description": "Activity logs collection"
    },
    "/system_config/{configId}": {
      "schema": { "$ref": "#/entities/system_config" },
      "description": "System branding and global config"
    }
  }
}
